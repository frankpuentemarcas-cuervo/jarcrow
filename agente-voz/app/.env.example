# --- FreeLLMAPI (copiá la "Unified API Key" desde el dashboard de la app) ---
FREELLM_BASE_URL=http://127.0.0.1:31415/v1
FREELLM_API_KEY=pega-tu-key-aqui
FREELLM_MODEL=auto

# --- Voz ---
# Modelos Whisper: tiny | base | small | medium  (small = buen balance en CPU)
WHISPER_MODEL=small
WHISPER_LANGUAGE=es
# Voces: es-PE-AlexNeural, es-PE-CamilaNeural, es-MX-JorgeNeural, es-MX-DaliaNeural...
TTS_VOICE=es-PE-AlexNeural
TTS_RATE=+10%

# --- Seguridad de comandos ---
# true = ejecuta comandos directamente sin pedir confirmación en ventana emergente
AUTO_APPROVE_COMMANDS=true
COMMAND_TIMEOUT=60

# --- Actualizaciones ---
AUTO_UPDATE=true
